<h2>予定一覧</h2>

<table>
  <tr>
    <th>ID</th>
    <th>タイトル</th>
    <th>開始日</th>
    <th>終了日</th>
    <th>終日</th>
    <th>更新日時</th>
    <th></th>
  </tr>

  <% @posts.each do |post| %>
    <tr>
      <td><%= post.id %></td>
      <td><%= post.title %></td>
      <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
      <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
      <td>
      <% if post.all_day %>
      ○
      <% end %>
      </td>
      <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
      <td>
      <%= link_to "詳細", post_path(post) %>
      <%= link_to "編集", edit_post_path(post) %>
      <%= link_to "削除", post_path(post), data: { turbo_method: :delete } %>
      </td>
    </tr>
  <% end %>
</table>
